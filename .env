NVIDIA_API_KEY=nvapi-REPLACE_ME
FIREWORKS_API_KEY=fw_REPLACE_ME
# Base URLs (fixed defaults; override only if your LM Studio uses a non-default port):
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LM Studio's local server needs NO real key. The OpenAI SDK, however, REQUIRES a non-empty
# api_key string. The router therefore uses env LMSTUDIO_API_KEY if present & non-empty,
# else the literal "lm-studio". NEVER pass an empty string.
LMSTUDIO_API_KEY=lm-studio
